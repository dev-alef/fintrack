# Base das rotas REST (/transactions, /goals, /finance...).
#
# Desenvolvimento: a API local, que serve essas rotas na raiz.
# Producao na Vercel: use /api - o vercel.json encaminha /api/<rota> para
# <api>/<rota>, para o navegador ver front e API como o mesmo site.
#
# Apontar isto para a API de producao enquanto se roda `npm run dev` faz o
# ambiente local escrever no banco de producao. Ja aconteceu.
VITE_API_URL=http://localhost:3001

# Origem do Better Auth. E a ORIGEM, sem caminho: o cliente acrescenta
# /api/auth sozinho. Por isso nao da para reaproveitar VITE_API_URL, que em
# producao vale '/api'.
#
# Producao na Vercel: deixe VAZIA ou nao defina - a origem atual e usada, e a
# requisicao passa pelo proxy do vercel.json.
VITE_AUTH_URL=http://localhost:3001

# Sentry - se deixado vazio, o Sentry fica desligado e a aplicação roda normalmente sem enviar erros
VITE_SENTRY_DSN=
