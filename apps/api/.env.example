PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://fintrack:fintrack123@localhost:5432/fintrack_db
REDIS_URL=redis://localhost:6379
# Restos do auth antigo. Nada le JWT_EXPIRES_IN nem JWT_REFRESH_*: a duracao da
# sessao agora e definida em auth.ts. JWT_SECRET sobrevive so como fallback do
# BETTER_AUTH_SECRET para ambientes que ainda nao foram atualizados.
JWT_SECRET=sua_chave_secreta_muito_longa_aqui_troque_em_producao

# Better Auth - assina os cookies de sessao. Gere o seu com:
#   openssl rand -base64 32
# Cole a SAIDA do comando, nao o comando. Quem tiver este valor consegue forjar
# uma sessao valida e entrar como qualquer usuario, sem senha.
BETTER_AUTH_SECRET=
# Origem pela qual o NAVEGADOR alcanca esta API - e dela que sai o redirect_uri
# mandado ao Google. Em producao a API fica atras do proxy da Vercel
# (apps/web/vercel.json), entao aqui vai a URL DO FRONT, nao a do Render: e o
# front que o navegador visita, e e la que os cookies precisam existir. Apontar
# para o Render faria o Google devolver a pessoa direto na API, num contexto
# onde o cookie de state nao existe, e o login falharia com state_mismatch.
BETTER_AUTH_URL=http://localhost:3001
# Origens do frontend, separadas por virgula. Nao aceita curinga: o navegador
# recusa credenciais com origem '*', entao cada origem precisa estar listada.
CORS_ORIGINS=http://localhost:5173

# Login com Google (opcional). Sem as duas, o botao "Continuar com Google"
# responde que o provedor nao esta disponivel e o resto do login segue normal.
# Credenciais em console.cloud.google.com > Clientes > Aplicativo da Web.
# O URI de redirecionamento autorizado precisa ser exatamente:
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate limiting: quais saltos do x-forwarded-for sao proxies confiaveis.
#
# O Better Auth recusa uma cadeia de mais de um salto quando nao sabe em quem
# confiar, e cai num balde unico compartilhado - uma pessoa tentando senhas em
# massa consome a cota de todos. Em producao a requisicao passa pela Vercel
# antes do Render, entao a cadeia tem dois saltos e isso acontece.
#
# Valores em CIDR separados por virgula, ex: 76.76.21.0/24,10.0.0.0/8
# Para descobrir os corretos, ligue DEBUG_IP=1 e chame /health pelo dominio do
# front: a resposta mostra a cadeia real. Depois desligue.
#
# Vazio mantem o comportamento atual (balde compartilhado), sem quebrar nada.
#
# Valor verificado em producao (29/08/2026) contra as cadeias reais, tanto pelo
# proxy da Vercel quanto batendo direto no Render. Sao as faixas publicadas da
# Cloudflare - que fica na frente do Render, o que nao e obvio -, mais a rede
# interna do Render e o IP de saida da Vercel.
#
# O ultimo, 54.20.54.113/32, e observado e nao publicado: a Vercel nao garante
# estabilidade nesse plano. Se ele mudar, o trafego que passa pelo proxy volta
# ao balde compartilhado - degrada com seguranca, nunca passa a confiar em quem
# nao deve. O sintoma e o aviso "could not determine a client IP" reaparecendo
# no log; a correcao e ligar DEBUG_IP=1, ler /health pelo dominio do front e
# atualizar esta variavel. Sem deploy, que e o motivo de estar aqui e nao no
# codigo.
TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32,10.0.0.0/8,54.20.54.113/32
# Cabecalhos consultados, em ordem. So mude se a infraestrutura usar outro nome.
# Em producao o valor correto e:
#
#   x-vercel-forwarded-for,x-forwarded-for
#
# O primeiro e posto pela Vercel e traz o IP real do cliente num valor unico.
# Ele existe porque confiar so no x-forwarded-for nao funciona pelo proxy: a
# Vercel sai por IPs variados e nao publicados, entao a cadeia para no salto
# dela - que muda a cada requisicao. O resultado e pior que o balde
# compartilhado: cada requisicao vira um balde novo, e o limite nunca acumula.
# Medido em producao, 6 tentativas seguidas de login passaram sem 429; batendo
# direto no Render, a quarta foi barrada.
#
# O x-forwarded-for continua na lista como segundo: quem bate direto no Render
# nao tem o cabecalho da Vercel, e ai a cadeia com TRUSTED_PROXIES resolve.
#
# Limite conhecido: quem bate direto no Render pode forjar
# x-vercel-forwarded-for e escapar do limite. Nao ha como distinguir daqui - a
# Vercel nao assina o cabecalho. Fechar isso exige restringir a origem no
# proprio Render, que e outro assunto.
IP_ADDRESS_HEADERS=x-forwarded-for
# Ligue temporariamente (=1) para /health revelar a cadeia de proxies.
DEBUG_IP=

GEMINI_API_KEY=
# Sentry - se deixado vazio, o Sentry fica desligado e a aplicação roda normalmente sem enviar erros
SENTRY_DSN=
