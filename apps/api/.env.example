PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://fintrack:fintrack123@localhost:5432/fintrack_db
REDIS_URL=redis://localhost:6379
# Restos do auth antigo. Nada le JWT_EXPIRES_IN nem JWT_REFRESH_*: a duracao da
# sessao agora e definida em auth.ts. JWT_SECRET sobrevive so como fallback do
# BETTER_AUTH_SECRET para ambientes que ainda nao foram atualizados.
JWT_SECRET=sua_chave_secreta_muito_longa_aqui_troque_em_producao

# Better Auth - assina os cookies de sessao. Gere o seu com:
#   openssl rand -base64 32
# Cole a SAIDA do comando, nao o comando. Quem tiver este valor consegue forjar
# uma sessao valida e entrar como qualquer usuario, sem senha.
BETTER_AUTH_SECRET=
# Origem pela qual o NAVEGADOR alcanca esta API - e dela que sai o redirect_uri
# mandado ao Google. Em producao a API fica atras do proxy da Vercel
# (apps/web/vercel.json), entao aqui vai a URL DO FRONT, nao a do Render: e o
# front que o navegador visita, e e la que os cookies precisam existir. Apontar
# para o Render faria o Google devolver a pessoa direto na API, num contexto
# onde o cookie de state nao existe, e o login falharia com state_mismatch.
BETTER_AUTH_URL=http://localhost:3001
# Origens do frontend, separadas por virgula. Nao aceita curinga: o navegador
# recusa credenciais com origem '*', entao cada origem precisa estar listada.
CORS_ORIGINS=http://localhost:5173

# Login com Google (opcional). Sem as duas, o botao "Continuar com Google"
# responde que o provedor nao esta disponivel e o resto do login segue normal.
# Credenciais em console.cloud.google.com > Clientes > Aplicativo da Web.
# O URI de redirecionamento autorizado precisa ser exatamente:
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate limiting por IP: por onde a requisicao passa antes de chegar aqui.
#
# Esta e a rede de fundo, generosa de proposito - quem segura o brute-force de
# login de verdade e o limite por CONTA (src/limite-por-conta.ts), que nao
# depende de IP nenhum e nao esta nesta lista porque nao e configuravel por
# ambiente. O limite por IP so evita volume bruto.
#
# Quem resolve o IP e src/ip-cliente.ts, lendo a cadeia do x-forwarded-for da
# direita para a esquerda e pulando os saltos listados abaixo, ate o primeiro
# desconhecido. O que o cliente escreve fica sempre a esquerda da cadeia, e
# essa leitura nunca chega la - e o que torna o valor impossivel de forjar.
#
# Nao ha entrada aqui para o proxy da Vercel. Pelo dominio do front, isto
# resolve para o IP de SAIDA da Vercel (compartilhado entre clientes dela, nao
# nosso), e nao para o IP de quem chamou - documentado em ip-cliente.ts. E o
# preco assumido: um IP de saida da Vercel na cadeia so prova "veio da rede da
# Vercel", nao "veio pelo rewrite do NOSSO projeto", e confiar nisso reabriria
# o forjamento por outra porta.
#
# Valores em CIDR ou IP solto, separados por virgula. Vazio nao quebra nada:
# todo mundo cai num balde compartilhado, que e restritivo demais e seguro.
#
# Verificado em producao (29/08/2026) contra as cadeias reais, batendo direto
# no Render. Sao as faixas publicadas da Cloudflare - que fica na frente do
# Render, o que nao e obvio - mais a rede interna do Render.
TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32,10.0.0.0/8

# IP_ADDRESS_HEADERS foi removido de proposito, nao esqueceram dele.
#
# A lista de cabecalhos define uma fronteira de confianca, e configuracao nao e
# lugar para isso: um valor antigo esquecido no painel do Render reabriria o
# forjamento em silencio - e ninguem investiga uma variavel que continua
# funcionando. Agora e codigo, e muda com deploy e revisao. Se a variavel ainda
# estiver definida no Render, pode apagar; nada le. VERCEL_PROXY_IPS tambem foi
# removida, pelo motivo explicado acima - se ainda estiver no Render, apague.

# Ligue temporariamente (=1) para /health revelar a cadeia de proxies real.
# Serve para conferir TRUSTED_PROXIES, nao para configurar a Vercel - o campo
# `resolvido` da resposta, batendo direto no Render, tem que ser o seu IP.
DEBUG_IP=

# Envio de e-mail (verificacao de conta e, em breve, recuperacao de senha).
#
# Sem as duas, o envio fica desligado e a mensagem vai para o log - e assim que
# se roda o projeto local sem conta em servico nenhum: o link de verificacao
# aparece no terminal e da para clicar nele.
#
# Em producao a ausencia e barulhenta de proposito: a API avisa no boot. E-mail
# de recuperacao que nao chega e ninguem percebe e o pior tipo de falha.
#
# A chave sai de resend.com > API Keys, com permissao de envio.
RESEND_API_KEY=
# Precisa ser de dominio verificado no Resend, senao o e-mail cai em spam.
EMAIL_FROM=Provisão <nao-responda@provisao.space>

# Destino das mensagens de suporte enviadas pelo app. Sem ela o formulario
# responde que o canal esta indisponivel, em vez de fingir que enviou - a
# pessoa ja esta com um problema e ficaria esperando um retorno que nao vem.
SUPPORT_EMAIL=

GEMINI_API_KEY=
# Sentry - se deixado vazio, o Sentry fica desligado e a aplicação roda normalmente sem enviar erros
SENTRY_DSN=
